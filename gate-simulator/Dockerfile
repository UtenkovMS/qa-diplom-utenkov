# Dockerfile описывает процесс сборки образов Docker в данному случае эмулятора gate-simulator:

# Используется официальный образ Node.js LTS.
FROM node:18

# директория в образе Docker куда будут скопированы файлы gate-simulator
WORKDIR /usr/src/gate-simulator

# Команда запускающая копирование файлов приложения
COPY . .

# Команда запуска установки приложения npm install
RUN npm install

# Команда запуска сервера
CMD ["npm", "start"]

# Порт сервера 9999
EXPOSE 9999

# Чтобы запустить сборку образа нужно перейти в директорию с приложением:
# Вводим команду: cd gate-simulator
# Далее вводим команду: docker build -t gate-simulator .
# Параметр -t устанавливает название образа, в данном примере это gate-emulator.
# Точка в конце обозначает текущую директорию, откуда будут браться файлы для сборки.
# После успешной сборки образа запускаем контейнер командой:
# docker run -d -p 9999:9999 gate-simulator
# -d — запускает контейнер в фоновом режиме (демон).
# -p 9999:9999 — сопоставляет порт 9999 внутри контейнера с портом 9999 на хост-компьютере.
# Приложение будет доступно по адресу http://localhost:9999.